// Based on the official Sipeed TangNano-20K UART example.
IO_LOC "clk" 4;
IO_LOC "reset_button" 88;
IO_LOC "uart_rx" 70;
IO_LOC "uart_tx" 69;
IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_PORT "reset_button" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
